{
  "expo": {
    "name": "Mes Finances",
    "slug": "suivi-finances",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hanaa17.suivifinances",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Protège l'accès à tes données financières."
      }
    },
    "plugins": [
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-asset",
      "expo-font"
    ]
  }
}
